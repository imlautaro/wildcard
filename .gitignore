# macOS
.DS_Store

# Xcode local state and build output
xcuserdata/
*.xcuserstate
DerivedData/
build/
*.xcarchive
*.ipa
*.dSYM/

# Local secrets
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
# Local-only Wrangler config generated by scripts/dev-api.mjs
apps/api/wrangler.local.json
# Account-specific Wrangler config generated by scripts/release-worker.mjs
apps/api/wrangler.release.json

# JavaScript dependencies and generated output
node_modules/
dist/
# `nuxt generate` links apps/site/dist to .output/public (a symlink, not a directory)
apps/site/dist
apps/docs/dist
# Nuxt Content's local SQLite database (apps/docs)
.data/
.wrangler/
.nuxt/
.output/
worker-configuration.d.ts
*.tsbuildinfo
.mini-app-eval/
