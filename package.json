{
  "name": "wildcard",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/admin",
    "apps/site",
    "apps/docs",
    "packages/ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/setup-local.mjs",
    "dev": "npm run dev --workspace @wildcard/api",
    "dev:all": "node scripts/dev-all.mjs",
    "smoke": "node scripts/smoke.mjs",
    "dev:web": "npm run dev --workspace @wildcard/web",
    "dev:admin": "npm run dev --workspace @wildcard/admin",
    "dev:site": "npm run dev --workspace @wildcard/site",
    "dev:docs": "npm run dev --workspace @wildcard/docs",
    "typecheck": "npm run typecheck --workspace @wildcard/api",
    "typecheck:web": "npm run typecheck --workspace @wildcard/web",
    "typecheck:admin": "npm run typecheck --workspace @wildcard/admin",
    "typecheck:site": "npm run typecheck --workspace @wildcard/site",
    "typecheck:docs": "npm run typecheck --workspace @wildcard/docs",
    "build": "npm run build --workspace @wildcard/api",
    "build:web": "npm run build --workspace @wildcard/web",
    "build:admin": "npm run build --workspace @wildcard/admin",
    "build:site": "npm run build --workspace @wildcard/site",
    "build:docs": "npm run build --workspace @wildcard/docs",
    "ios": "open apps/ios/Wildcard.xcodeproj",
    "release:ci": "node scripts/release-worker.mjs",
    "deploy": "node scripts/release-all.mjs",
    "release:check": "node scripts/release-worker.mjs --dry-run",
    "release:web": "node scripts/release-web.mjs",
    "release:admin": "node scripts/release-admin.mjs",
    "release:site": "node scripts/release-site.mjs",
    "release:docs": "node scripts/release-docs.mjs",
    "preview:web": "node scripts/preview-web.mjs",
    "infra:provision": "node scripts/provision.mjs",
    "infra:photos": "node scripts/provision.mjs",
    "db:migrate:local": "npm run db:migrate:local --workspace @wildcard/api",
    "auth:setup:local": "npm run setup",
    "infra:ai-gateway": "node scripts/provision-ai-gateway.mjs",
    "test:lifecycle": "npm run test:lifecycle --workspace @wildcard/api",
    "typecheck:lifecycle": "npm run typecheck:lifecycle --workspace @wildcard/api"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "vue-demi": true,
    "workerd": true
  },
  "cloudflare": {
    "bindings": {
      "META_API_KEY": {
        "description": "**Required.** Meta Model API key for replies, contact generation and images (Muse Spark 1.3, Muse Image, Muse Voice Transcribe)."
      },
      "ELEVENLABS_API_KEY": {
        "description": "Optional. ElevenLabs key for contact voices. Leave empty to turn voices off."
      }
    }
  }
}
