<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>MCP authorization</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wildcard</string>
			</array>
		</dict>
	</array>
	<!-- Deprecated NFC configuration; retained for reference.
	<key>NFCReaderUsageDescription</key>
	<string>Read or write a contact link on an NFC tag when you request it.</string>
	-->
	<key>NSAlarmKitUsageDescription</key>
	<string>Schedule alarms and timers you explicitly run from a contact.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Record a voice message and transcribe it into text with Meta before sending.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Save reminders you review and run, including arrival and departure reminders. Wildcard does not read your reminder lists for AI context.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSUserActivityTypes</key>
	<array>
		<string>INSendMessageIntent</string>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>Manrope.ttf</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>WildcardLaunch</string>
	<key>WildcardAPIURL</key>
	<string>$(WILDCARD_API_URL)</string>
	<key>WildcardAppGroup</key>
	<string>$(WILDCARD_APP_GROUP)</string>
	<key>WildcardLinkHost</key>
	<string>$(WILDCARD_LINK_HOST)</string>
	<key>WildcardPushEnvironment</key>
	<string>$(APNS_ENVIRONMENT)</string>
</dict>
</plist>
