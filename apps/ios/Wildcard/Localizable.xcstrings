        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te escribió en privado"
          }
        }
      }
    },
    "Messages and shared memories sent to Meta may be used to train its models." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mensajes y las memorias compartidas que se envían a Meta pueden usarse para entrenar sus modelos."
          }
        }
      }
    },
    "Messages can contain up to 4,000 characters." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mensajes pueden tener hasta 4000 caracteres."
          }
        }
      }
    },
    "Messages you already sent keep their sticker." : {
      "localizations" : {
        "es" : {
