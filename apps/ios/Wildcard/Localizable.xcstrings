        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vez"
          }
        }
      }
    },
    "One shared character, with a relationship that follows each person across chats and groups. Private conversations stay private. Only its creator can edit these settings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mismo personaje compartido, con una relación que acompaña a cada persona en chats y grupos. Las conversaciones privadas siguen siendo privadas. Solo quien lo creó puede editar esta configuración."
          }
        }
      }
    },
    "Online" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En línea"
          }
        }
      }
    },
    "Only contacts you created can be added. Contacts already in the group are marked and cannot be selected." : {
      "localizations" : {
