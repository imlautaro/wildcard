    "Age" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edad"
          }
        }
      }
    },
    "Age is calculated from the date of birth in the birthday time zone. February 29 is observed on February 28 in other years." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La edad se calcula a partir de la fecha de nacimiento en la zona horaria del cumpleaños. El 29 de febrero se celebra el 28 de febrero en los demás años."
          }
        }
      }
    },
