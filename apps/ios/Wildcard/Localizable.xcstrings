    "Members can read the group's history, including messages sent before they joined, unless they were added without earlier messages." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los miembros pueden leer el historial del grupo, incluidos los mensajes enviados antes de unirse, salvo que se les haya añadido sin mensajes anteriores."
          }
        }
      }
    },
