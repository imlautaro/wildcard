    "Enable all %lld tools for %@ without asking again? This includes tools hidden by search. These tools may read, change, or send external data. Only enable tools you understand and trust." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Activar las %1$lld herramientas de %2$@ sin volver a preguntar? Esto incluye las herramientas ocultas por la búsqueda. Estas herramientas pueden leer, cambiar o enviar datos externos. Activa solo herramientas que entiendas y en las que confíes."
          }
        }
      }
    },
