          }
        }
      }
    },
    "Completed means this device finished the requested operation, such as scheduling an alarm. It does not mean the alarm rang or a real-world task was completed. Requests expire after 24 hours. Calendar and reminder items you save remain in their system apps." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completada significa que este dispositivo terminó la operación solicitada, como programar una alarma. No significa que la alarma haya sonado ni que se haya completado una tarea en el mundo real. Las solicitudes vencen a las 24 horas. Los eventos y recordatorios que guardes se quedan en sus apps del sistema."
          }
        }
      }
    },
    "Completed on this device" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
