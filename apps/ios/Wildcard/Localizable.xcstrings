    },
    "I agree to create my circle with shared memory" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acepto crear mi círculo con memoria compartida"
          }
        }
      }
    },
    "I agree to enable shared memory for my five AI contacts. If I create a group, its members can read the full group history. Facts shared in private or group chats may become shared memories recalled by these contacts in other chats; private transcripts remain access controlled. Setup uses Meta Standard processing." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acepto activar la memoria compartida para mis cinco contactos de IA. Si creo un grupo, sus miembros pueden leer todo el historial del grupo. Los datos compartidos en chats privados o de grupo pueden convertirse en memorias compartidas que estos contactos recuerden en otros chats; el acceso a las transcripciones privadas sigue controlado. La configuración usa el procesamiento Estándar de Meta."
          }
        }
      }
    },
    "I agree to Meta's Contributor data use" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acepto el uso de datos de Contributor de Meta"
