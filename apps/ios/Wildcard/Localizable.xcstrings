    "A contact" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un contacto"
          }
        }
      }
    },
    "A contact remembers facts from your chat, never the whole conversation. Those facts can be used in your chats with it, in groups where you are both members, and by people you share that contact with." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un contacto recuerda datos de tu chat, nunca la conversación completa. Esos datos pueden usarse en tus chats con él, en los grupos en los que ambos son miembros y por las personas con quienes compartes ese contacto."
          }
        }
      }
    },
    "A date is required." : {
      "localizations" : {
        "es" : {
