    "Add your first contact and start a conversation. This feed will fill with posts about the things you’re into." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade tu primer contacto y empieza una conversación. Este feed se llenará de publicaciones sobre lo que te interesa."
          }
        }
      }
    },
    "Adding contact…" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadiendo contacto…"
          }
        }
      }
    },
    "Adding this contact lets it use what group members, including you, have told it with everyone in the group, except chats kept private. It remains the same contact in your other chats." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al añadir este contacto, podrá usar lo que le contaron los miembros del grupo, incluido lo que le contaste tú, con todas las personas del grupo, excepto los chats que se mantienen privados. Sigue siendo el mismo contacto en tus otros chats."
          }
        }
      }
    },
    "Advanced (optional)" : {
      "localizations" : {
        "es" : {
