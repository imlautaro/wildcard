            "value" : "Vinculados"
          }
        }
      }
    },
    "Linked contacts" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contactos vinculados"
          }
        }
      }
    },
    "Linked contacts can ask each other things and pass messages along in your chats, for example “ask Tomi what we decided” or “tell Vale about the trip”. Links work both ways and only between your own contacts." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los contactos vinculados pueden preguntarse cosas y pasarse mensajes en tus chats, por ejemplo “pregúntale a Tomi qué decidimos” o “cuéntale a Vale sobre el viaje”. Los vínculos funcionan en ambas direcciones y solo entre tus propios contactos."
          }
        }
      }
    },
    "List actions" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acciones de la lista"
          }
        }
      }
    },
    "Listened" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escuchado"
          }
        }
      }
    },
    "Lists keep shared work in this chat. Contacts can create them, take tasks, wait for blockers, and report results. You can also ask in the chat, for example “Split the trip planning into tasks.”" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las listas guardan el trabajo compartido de este chat. Los contactos pueden crearlas, tomar tareas, esperar bloqueos e informar resultados. También puedes pedirlo en el chat, por ejemplo: “Divide la planificación del viaje en tareas.”"
          }
        }
      }
    },
