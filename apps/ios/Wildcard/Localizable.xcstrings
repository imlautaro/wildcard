    },
    "Lets you set timers and alarms on this iPhone from the web, and lets people you choose who also chat with %@ do the same." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te permite programar temporizadores y alarmas en este iPhone desde la web, y que las personas que elijas que también chatean con %@ hagan lo mismo."
