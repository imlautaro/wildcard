{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Nitro merges this file into .output/server/wrangler.json and adds `main` and
  // `assets`. Release with that generated file; never deploy manually.
  "name": "wildcard-web",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  // preview_urls is set in nuxt.config.ts (nitro.cloudflare.wrangler), which overrides this file.
  "observability": {
    "redact_query_string": true,
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "services": [
    {
      "binding": "API",
      "service": "wildcard-api"
    }
  ],
  // Previews (`wrangler preview`, Workers Builds on non-production branches) don't inherit
  // the settings above. Their API binding calls wildcard-api's production deployment.
  "previews": {
    "services": [
      {
        "binding": "API",
        "service": "wildcard-api"
      }
    ]
  }
}
