{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "wildcard-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "redact_query_string": true,
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "account_id": "a9e3a97d08ec5023cbe6b97a1a25fec6",
  "vars": {
    "MCP_WEB_ORIGIN": "https://wildcard-web.imlautaro.workers.dev",
    "BETTER_AUTH_URL": "https://wildcard-api.imlautaro.workers.dev",
    "META_CHAT_MODEL": "muse-spark-1.3",
    "AI_GATEWAY_ID": "",
    "WEB_RESEARCH_ENABLED": "true",
    "SEMANTIC_MEMORY_ENABLED": "false",
    // Comma-separated user IDs allowed into apps/admin. Not secret; see docs/admin.md.
    "SUPER_ADMIN_USER_IDS": "F16b7zR7fmdk1HJcFfX9kUOxSW3fvFmM"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wildcard-db",
      "database_id": "ac55a941-27bf-4182-ac8a-8aebda43524f",
      "migrations_dir": "migrations"
    }
  ],
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "META_API_KEY"
    ]
  },
  "workflows": [
    { "name": "wildcard-onboarding", "binding": "ONBOARDING_WORKFLOW", "class_name": "OnboardingWorkflow" },
    {
      "name": "wildcard-chat",
      "binding": "CHAT_WORKFLOW",
      "class_name": "ChatWorkflow"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "r2_buckets": [
    {
      "binding": "CONTACT_PHOTOS",
      "bucket_name": "wildcard-contact-photos"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
