{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "wildcard-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "redact_query_string": true,
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  // Account-neutral on purpose: no account_id, D1 ID, installation URLs or admin IDs.
  // scripts/release-worker.mjs fills them in for the account it releases to
  // (docs/infrastructure.md#self-hosting). Local development uses apps/api/.dev.vars.
  "vars": {
    // Release: WILDCARD_WEB_URL, or https://wildcard-web.<subdomain>.workers.dev.
    "MCP_WEB_ORIGIN": "",
    // Release: WILDCARD_API_URL, or https://wildcard-api.<subdomain>.workers.dev.
    "BETTER_AUTH_URL": "",
    "META_CHAT_MODEL": "muse-spark-1.3",
    "AI_GATEWAY_ID": "",
    "WEB_RESEARCH_ENABLED": "true",
    "SEMANTIC_MEMORY_ENABLED": "false",
    // Updates curation runs (docs/updates.md). "false" keeps Updates to quick access and agenda.
    "HOME_FEED_ENABLED": "true",
    // Comma-separated user IDs allowed into apps/admin. Not secret; see docs/admin.md.
    // Release: WILDCARD_SUPER_ADMIN_USER_IDS.
    "SUPER_ADMIN_USER_IDS": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wildcard-db",
      // Local development only. Releases look the database up by name (WILDCARD_DB_NAME
      // overrides it) and create it on the first release.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "META_API_KEY"
    ]
  },
  "workflows": [
    { "name": "wildcard-onboarding", "binding": "ONBOARDING_WORKFLOW", "class_name": "OnboardingWorkflow" },
    {
      "name": "wildcard-chat",
      "binding": "CHAT_WORKFLOW",
      "class_name": "ChatWorkflow"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "r2_buckets": [
    {
      "binding": "CONTACT_PHOTOS",
      "bucket_name": "wildcard-contact-photos"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
