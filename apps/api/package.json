{
  "name": "@wildcard/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types --strict-vars false",
    "typecheck": "npm run types && tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test:lifecycle": "node --test --test-concurrency=1 tests/lifecycle.test.mjs",
    "test:memory-isolation": "node --test --test-concurrency=1 --test-name-pattern=\"isolation:\" tests/lifecycle.test.mjs",
    "typecheck:lifecycle": "tsc --noEmit -p tests/tsconfig.json"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.13",
    "@cfworker/json-schema": "4.1.1",
    "@meta-sam/parser": "0.1.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-auth": "1.7.13",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "jpeg-js": "0.4.4",
    "markdown-it": "15.0.3",
    "upng-js": "2.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "@types/upng-js": "2.1.5",
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.0-beta",
    "typescript": "7.0.2",
    "wrangler": "4.153.0"
  }
}
