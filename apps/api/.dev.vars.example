BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional locally; required for generating replies. Never commit a real key.
META_API_KEY=

# Each account selects its model in Account. New/existing accounts default to Standard.
META_CHAT_MODEL=muse-spark-1.3

# Disable the optional remote AI Gateway for local emulation/direct Meta requests.
# To use it, provision wildcard and custom-meta in your own account first.
AI_GATEWAY_ID=

# Optional APNs setup; use your own Apple key and identifiers. Never commit values.
# Local macOS workerd may not support the HTTP/2 connection APNs requires.
# APNS_PRIVATE_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=

# Local admin panel (docs/admin.md). wrangler dev cannot serve the AdminAPI
# entrypoint, so this mounts the admin routes on the local public app. Never set it
# in wrangler.jsonc. Put your local account ID in the roster to sign in.
# ADMIN_LOCAL_ROUTES=true
# SUPER_ADMIN_USER_IDS=

# OAuth requires a public HTTPS API in BETTER_AUTH_URL and a public HTTPS web origin.
# Public/Bearer connections still work with local HTTP; do not put OAuth secrets here.
# MCP_WEB_ORIGIN=https://your-web-host.example.com
